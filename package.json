    "firebase-admin": "14.4.0",
    "lucide-react": "1.47.0",
    "mongoose": "9.10.2",
    "next": "16.3.6",
    "qrcode.react": "4.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "daisyui": "5.7.46",
    "eslint": "9.39.5",
