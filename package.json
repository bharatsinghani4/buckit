  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0 <23",
    "npm": ">=10"
  },
  "scripts": {
    "db:setup": "node --conditions=react-server --import tsx scripts/setup-db.ts",
    "dev": "next dev",
