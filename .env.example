# Optional for the scaffold. Copy to .env.local before connecting services.
# Server-only: never prefix these with NEXT_PUBLIC_.
MONGODB_URI=
MONGODB_DB_NAME=buckit
# Generate a random secret of at least 32 bytes for signed pagination cursors.
API_CURSOR_SECRET=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Quoted PEM; literal \n escapes are supported by the Admin helper.
FIREBASE_PRIVATE_KEY=
# Required in Vercel for the protected daily posting route. Use a random 32+ byte secret.
CRON_SECRET=

# Public Firebase web-app configuration (not Admin credentials).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# Reserved for future explicit web-push opt-in.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
