# Optional for the scaffold. Copy to .env.local before connecting services.
# Server-only: never prefix these with NEXT_PUBLIC_.
MONGODB_URI=
MONGODB_DB_NAME=buckit
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Quoted PEM; literal \n escapes are supported by the Admin helper.
FIREBASE_PRIVATE_KEY=
# Reserved for the future protected daily job route; no cron is enabled yet.
CRON_SECRET=

# Public Firebase web-app configuration (not Admin credentials).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# Reserved for future explicit web-push opt-in.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
